{%- liquid
  comment
    Renders bundle builder for yogurt products with granola upsell

    @param {product} product - The main yogurt product
    @param {product} granola_product - The granola product for upsell
    @param {object} settings - Block settings
    @param {string} shopify_attributes - Shopify attributes for the block
    @param {string} section_id - Section ID for unique identifiers
  endcomment

  assign selected_variant = product.selected_or_first_available_variant

  comment Find the Size option (should be option1)
  endcomment
  assign size_option_name = product.options_with_values[0].name
  assign quantity_option_name = product.options_with_values[1].name

  comment Get all unique sizes
  endcomment
  assign sizes = product.options_with_values[0].values

  comment Get all quantities (1-6)
  endcomment
  assign quantities = product.options_with_values[1].values

  comment Get granola variant and price
  endcomment
  if granola_product
    assign granola_variant = granola_product.selected_or_first_available_variant
    assign granola_price = granola_variant.price
  endif
-%}

<div
  class="bundle-builder spacing-style"
  style="{% render 'spacing-style', settings: settings %}"
  {{ shopify_attributes }}
  data-testid="bundle-builder"
>
  <bundle-builder-component
    data-product-id="{{ product.id }}"
    data-granola-product-id="{{ granola_product.id }}"
    data-granola-variant-id="{{ granola_variant.id }}"
    data-granola-price="{{ granola_price }}"
    data-max-granola="{{ settings.max_granola_quantity }}"
    data-section-id="{{ section_id }}"
  >
    {%- comment -%} Bundle Quantity Selection with Swatches {%- endcomment -%}
    <div class="bundle-builder__section">
      <label class="bundle-builder__label">{{ settings.bundle_label }}</label>
      <div class="bundle-builder__quantity-grid" ref="quantityGrid">
        {%- for quantity in quantities -%}
          {%- liquid
            comment Find the variant for current selected size + this quantity
            endcomment
            assign current_size = selected_variant.option1
            assign variant_for_quantity = null

            for variant in product.variants
              if variant.option1 == current_size and variant.option2 == quantity
                assign variant_for_quantity = variant
                break
              endif
            endfor
          -%}

          {%- if variant_for_quantity -%}
            <button
              type="button"
              class="bundle-builder__quantity-btn{% if forloop.first %} bundle-builder__quantity-btn--active{% endif %}"
              data-quantity="{{ quantity }}"
              data-variant-id="{{ variant_for_quantity.id }}"
              data-price="{{ variant_for_quantity.price }}"
              data-size="{{ current_size }}"
              data-compare-price="{{ variant_for_quantity.compare_at_price }}"
            >
              {%- if variant_for_quantity.featured_image -%}
                <img
                  src="{{ variant_for_quantity.featured_image | image_url: width: 100 }}"
                  alt="{{ quantity }}x {{ current_size }}"
                  class="bundle-builder__quantity-image"
                  loading="lazy"
                >
              {%- endif -%}
              <span class="bundle-builder__quantity-multiplier">{{ quantity }}x</span>
              <span class="bundle-builder__quantity-price">{{ variant_for_quantity.price | money }}</span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} Savings Display {%- endcomment -%}
    <div class="bundle-builder__savings" ref="savingsDisplay" style="display: none;">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="bundle-builder__savings-icon">
        <path d="M8 0L10.472 5.528L16 8L10.472 10.472L8 16L5.528 10.472L0 8L5.528 5.528L8 0Z" fill="currentColor"/>
      </svg>
      <span ref="savingsText"></span>
    </div>

    {%- comment -%} Add Granola Option {%- endcomment -%}
    <div class="bundle-builder__section bundle-builder__granola-option">
      <div class="bundle-builder__granola-toggle">
        <input
          type="checkbox"
          id="granola-toggle-{{ section_id }}"
          class="bundle-builder__granola-checkbox"
          ref="granolaCheckbox"
        >
        <label for="granola-toggle-{{ section_id }}" class="bundle-builder__granola-toggle-label">
          {%- if granola_product and granola_product.featured_image -%}
            <img
              src="{{ granola_product.featured_image | image_url: width: 60 }}"
              alt="{{ granola_product.title }}"
              class="bundle-builder__granola-image"
              loading="lazy"
            >
          {%- endif -%}
          <div class="bundle-builder__granola-info">
            <span class="bundle-builder__label">{{ settings.granola_label }}</span>
            {%- if granola_product -%}
              <span class="bundle-builder__label-price">({{ granola_price | money }} {{ settings.granola_each_label }})</span>
            {%- endif -%}
          </div>
        </label>
      </div>

      <div class="bundle-builder__granola-controls" ref="granolaControls" style="display: none;">
        <label class="bundle-builder__granola-qty-label">{{ settings.granola_quantity_label }}</label>
        <div class="bundle-builder__granola-selector">
          <button type="button" class="bundle-builder__granola-btn" data-action="decrease" ref="decreaseBtn">
            <span class="visually-hidden">Decrease quantity</span>
            <svg width="12" height="2" viewBox="0 0 12 2" fill="none">
              <path d="M0 1H12" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </button>
          <input
            type="number"
            class="bundle-builder__granola-input"
            value="1"
            min="1"
            ref="granolaInput"
            aria-label="Granola quantity"
          >
          <button type="button" class="bundle-builder__granola-btn" data-action="increase" ref="increaseBtn">
            <span class="visually-hidden">Increase quantity</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M6 0V12M0 6H12" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    {%- comment -%} Price Summary {%- endcomment -%}
    <div class="bundle-builder__summary">
      <div class="bundle-builder__summary-line">
        <span>{{ settings.bundle_price_label }}:</span>
        <span ref="bundlePrice">{{ selected_variant.price | money }}</span>
      </div>
      <div class="bundle-builder__summary-line bundle-builder__summary-line--granola" ref="granolaLine" style="display: none;">
        <span>{{ settings.granola_price_label }} <span ref="granolaQtyText">(x1)</span>:</span>
        <span ref="granolaPrice">{{ granola_price | money }}</span>
      </div>
      <div class="bundle-builder__summary-line bundle-builder__summary-total">
        <strong>{{ settings.total_label }}:</strong>
        <strong ref="totalPrice">{{ selected_variant.price | money }}</strong>
      </div>
    </div>

    {%- comment -%} Hidden data for all variants {%- endcomment -%}
    <script type="application/json" ref="variantData">
      {
        "variants": [
          {%- for variant in product.variants -%}
            {
              "id": {{ variant.id | json }},
              "size": {{ variant.option1 | json }},
              "quantity": {{ variant.option2 | json }},
              "price": {{ variant.price | json }},
              "comparePrice": {{ variant.compare_at_price | json }},
              "available": {{ variant.available | json }},
              "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 100 | json }}{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  </bundle-builder-component>
</div>

{% stylesheet %}
  .bundle-builder {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .bundle-builder__section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bundle-builder__label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .bundle-builder__label-price {
    font-weight: 400;
    color: var(--color-foreground-secondary);
    font-size: 0.875rem;
  }

  .bundle-builder__quantity-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: 12px;
  }

  @media (max-width: 749px) {
    .bundle-builder__quantity-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .bundle-builder__quantity-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 12px;
    background: var(--color-background);
    border: 2px solid var(--color-border);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
  }

  .bundle-builder__quantity-btn:hover {
    border-color: var(--color-primary);
    background: var(--color-background-secondary);
  }

  .bundle-builder__quantity-btn--active {
    border-color: var(--color-primary);
    background: var(--color-primary-opacity-10);
  }

  .bundle-builder__quantity-image {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 4px;
  }

  .bundle-builder__quantity-multiplier {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .bundle-builder__quantity-price {
    font-size: 0.875rem;
    color: var(--color-foreground-secondary);
  }

  /* Savings Display */
  .bundle-builder__savings {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: #e8f5e9;
    color: #2e7d32;
    border-radius: 8px;
    font-weight: 500;
  }

  .bundle-builder__savings-icon {
    flex-shrink: 0;
  }

  /* Granola Option */
  .bundle-builder__granola-option {
    gap: 16px;
    margin-top: 32px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }

  .bundle-builder__granola-toggle {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .bundle-builder__granola-checkbox {
    width: 20px;
    height: 20px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .bundle-builder__granola-toggle-label {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    flex: 1;
  }

  .bundle-builder__granola-image {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }

  .bundle-builder__granola-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .bundle-builder__granola-controls {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-left: 32px;
    margin-top: 16px;
  }

  .bundle-builder__granola-qty-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-foreground);
  }

  .bundle-builder__granola-selector {
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: 200px;
  }

  .bundle-builder__granola-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .bundle-builder__granola-btn:hover {
    background: var(--color-background-secondary);
    border-color: var(--color-primary);
  }

  .bundle-builder__granola-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .bundle-builder__granola-input {
    flex: 1;
    text-align: center;
    font-size: 1.125rem;
    font-weight: 600;
    padding: 8px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .bundle-builder__granola-input::-webkit-inner-spin-button,
  .bundle-builder__granola-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .bundle-builder__summary {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
    background: var(--color-background-secondary);
    border-radius: 8px;
  }

  .bundle-builder__summary-line {
    display: flex;
    justify-content: space-between;
    font-size: 1rem;
    color: var(--color-foreground);
  }

  .bundle-builder__summary-total {
    padding-top: 8px;
    border-top: 1px solid var(--color-border);
    font-size: 1.125rem;
  }
{% endstylesheet %}
