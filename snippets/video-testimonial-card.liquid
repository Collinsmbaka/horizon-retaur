{% liquid
  assign source = 'uploaded'
  if video_url != blank
    assign source = 'url'
  endif
%}

<div class="video-testimonial">
  {%- comment -%} Video Section {%- endcomment -%}
  <div class="video-testimonial__video">
    {% if source == 'uploaded' and video != blank %}
      {% render 'video',
        video: video,
        video_class: 'video-testimonial__media',
        video_loop: true,
        video_preview_image: cover_image,
        section_id: section_id
      %}
    {% elsif source == 'url' and video_url != blank %}
      {% render 'video',
        video_from_url: true,
        video: video_url.id,
        video_class: 'video-testimonial__media',
        video_type: video_url.type,
        video_alt: customer_name,
        video_preview_image: cover_image,
        section_id: section_id
      %}
    {% endif %}
  </div>

  {%- comment -%} Customer Info & Rating {%- endcomment -%}
  <div class="video-testimonial__info">
    {% if customer_name != blank %}
      <p class="video-testimonial__customer-name h6">
        {{ customer_name }}
      </p>
    {% endif %}

    {% if rating > 0 %}
      <div class="video-testimonial__rating">
        <svg
          class="visually-hidden"
          style="width: 0; height: 0;"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 32 32"
          role="presentation"
        >
          <defs>
            <symbol xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" id="testimonial-star-{{ section_id }}">
              <path d="M31.547 12a.848.848 0 00-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 00-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 00-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 001.23.893l8.428-4.434 8.432 4.432a.847.847 0 001.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 00.214-.869z" />
            </symbol>
          </defs>
        </svg>

        <div
          class="rating rating-color--{{ rating_color }}"
          style="--star-size: {{ star_size }}px;"
          aria-label="Rating: {{ rating }} out of 5 stars"
        >
          {%- for star in (1..5) -%}
            <svg
              class="stars {% if star <= rating %}filled-star{% endif %}"
              viewBox="0 0 32 32"
              role="presentation"
            >
              <use xlink:href="#testimonial-star-{{ section_id }}"></use>
            </svg>
          {%- endfor -%}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .video-testimonial {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    width: 100%;
  }

  .video-testimonial__video {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--border-radius, 0);
  }

  .video-testimonial__media {
    width: 100%;
    aspect-ratio: 9/16;
    object-fit: cover;
  }

  .video-testimonial__info {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .video-testimonial__customer-name {
    margin: 0;
    font-weight: 600;
  }

  .video-testimonial__rating {
    display: flex;
    align-items: center;
  }

  .rating {
    display: flex;
    gap: var(--gap-3xs);
    align-items: center;
  }

  .rating-color--primary {
    --star-fill-color: var(--color-primary);
    --star-fill-color-rgb: var(--color-primary-rgb);
  }

  .rating-color--foreground {
    --star-fill-color: var(--color-foreground);
    --star-fill-color-rgb: var(--color-foreground-rgb);
  }

  .rating-color--accent {
    --star-fill-color: #FFD700;
    --star-fill-color-rgb: 255, 215, 0;
  }

  .stars {
    height: var(--star-size);
    fill: rgb(var(--star-fill-color-rgb) / 0.2);
  }

  .filled-star {
    fill: var(--star-fill-color);
  }
{% endstylesheet %}
