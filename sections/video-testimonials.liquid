{% liquid
  assign testimonials_count = 0

  for i in (1..6)
    assign video_key = 'video_' | append: i
    assign video = section.settings[video_key]
    if video != blank
      assign testimonials_count = testimonials_count | plus: 1
    endif
  endfor

  if section.settings.layout_type == 'carousel'
    assign max_items = section.settings.columns | plus: 2
  else
    assign max_items = testimonials_count
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-video-testimonials
    spacing-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    --content-gap: {{ section.settings.gap }}px;
  "
>
  {% if section.settings.heading != blank %}
    {% liquid
      assign heading_settings = section.settings
      if section.settings.heading_preset == 'custom'
        assign heading_settings_obj = '{"type_preset":"custom","font":"' | append: section.settings.heading_font | append: '","font_size":"' | append: section.settings.heading_font_size | append: '","line_height":"' | append: section.settings.heading_line_height | append: '","letter_spacing":"' | append: section.settings.heading_letter_spacing | append: '","case":"' | append: section.settings.heading_case | append: '","wrap":"' | append: section.settings.heading_wrap | append: '","color":"' | append: section.settings.heading_color | append: '"}'
      endif
    %}
    <div class="video-testimonials__heading-wrapper text-{{ section.settings.heading_alignment }}">
      <div class="video-testimonials__heading">
        {% if section.settings.heading_preset == 'custom' %}
          <div
            class="custom-heading custom-typography custom-color"
            style="
              --font-family: {{ section.settings.heading_font }};
              --font-weight: {{ section.settings.heading_font | replace: 'family', 'weight' }};
              --font-size: {{ section.settings.heading_font_size }};
              --line-height: var(--line-height--heading-{{ section.settings.heading_line_height }});
              --letter-spacing: var(--letter-spacing--heading-{{ section.settings.heading_letter_spacing }});
              --text-transform: {{ section.settings.heading_case }};
              --text-wrap: {{ section.settings.heading_wrap }};
              --color: {{ section.settings.heading_color }};
              font-family: var(--font-family);
              font-weight: var(--font-weight);
              font-size: var(--font-size);
              line-height: var(--line-height);
              letter-spacing: var(--letter-spacing);
              text-transform: var(--text-transform);
              text-wrap: var(--text-wrap);
              color: var(--color);
            "
          >
            {{ section.settings.heading }}
          </div>
        {% else %}
          <{{ section.settings.heading_preset }} class="{{ section.settings.heading_preset }}">
            {{ section.settings.heading }}
          </{{ section.settings.heading_preset }}>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% capture list_items %}
    {% for i in (1..6) %}
      {% liquid
        assign video_key = 'video_' | append: i
        assign video_url_key = 'video_url_' | append: i
        assign cover_key = 'cover_image_' | append: i
        assign name_key = 'customer_name_' | append: i
        assign rating_key = 'rating_' | append: i

        assign video = section.settings[video_key]
        assign video_url = section.settings[video_url_key]
        assign cover_image = section.settings[cover_key]
        assign customer_name = section.settings[name_key]
        assign rating = section.settings[rating_key]
      %}

      {% if video != blank or video_url != blank %}
        <div class="video-testimonials__item">
          {% render 'video-testimonial-card',
            video: video,
            video_url: video_url,
            cover_image: cover_image,
            customer_name: customer_name,
            rating: rating,
            rating_color: section.settings.rating_color,
            star_size: section.settings.star_size,
            section_id: section.id
          %}
        </div>
        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endif %}
    {% endfor %}
  {% endcapture %}

  {% liquid
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    carousel_ref: 'videoTestimonials',
    slide_count: max_items,
    content_type: 'testimonials',
    test_id: 'video-testimonials-list'
  %}
</div>

{% stylesheet %}
  .section-video-testimonials {
    display: grid;
  }

  .video-testimonials__heading-wrapper {
    margin-block-end: var(--content-gap);
  }

  .video-testimonials__heading-wrapper.text-left .video-testimonials__heading,
  .video-testimonials__heading-wrapper.text-left .custom-heading,
  .video-testimonials__heading-wrapper.text-left h1,
  .video-testimonials__heading-wrapper.text-left h2,
  .video-testimonials__heading-wrapper.text-left h3 {
    text-align: left;
  }

  .video-testimonials__heading-wrapper.text-center .video-testimonials__heading,
  .video-testimonials__heading-wrapper.text-center .custom-heading,
  .video-testimonials__heading-wrapper.text-center h1,
  .video-testimonials__heading-wrapper.text-center h2,
  .video-testimonials__heading-wrapper.text-center h3 {
    text-align: center;
  }

  .video-testimonials__heading-wrapper.text-right .video-testimonials__heading,
  .video-testimonials__heading-wrapper.text-right .custom-heading,
  .video-testimonials__heading-wrapper.text-right h1,
  .video-testimonials__heading-wrapper.text-right h2,
  .video-testimonials__heading-wrapper.text-right h3 {
    text-align: right;
  }
{% endstylesheet %}

