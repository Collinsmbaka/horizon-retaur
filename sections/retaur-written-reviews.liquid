{%- liquid
  assign section_settings = section.settings
-%}

<section
  class="retaur-reviews retaur-section--cream spacing-style"
  style="{% render 'spacing-style', settings: section_settings %}"
>
  <div class="retaur-container">
    {%- if section_settings.eyebrow != blank -%}
      <div class="retaur-section-eyebrow">{{ section_settings.eyebrow | escape }}</div>
    {%- endif -%}
    {%- if section_settings.title != blank -%}
      <h2 class="retaur-section-title">{{ section_settings.title }}</h2>
    {%- endif -%}
    {%- if section_settings.lede != blank -%}
      <div class="retaur-section-lede">{{ section_settings.lede }}</div>
    {%- endif -%}

    <div class="retaur-reviews__widget">
      {% content_for 'blocks' %}
    </div>

    {%- if section_settings.cta_link != blank and section_settings.cta_label != blank -%}
      <div class="retaur-reviews__cta">
        <a class="retaur-reviews__cta-link" href="{{ section_settings.cta_link | escape }}">{{ section_settings.cta_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Retaur written reviews",
  "tag": "section",
  "blocks": [
    { "type": "@app" }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer reviews" },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title (use italic for accent)",
      "default": "<p>Don't take our word<br>for <em>it</em>.</p>"
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "Lede paragraph",
      "default": "<p>Real customers, real reviews. Watch them on Instagram, read them on Judge.me, or just buy a cup and find out for yourself.</p>"
    },
    {
      "type": "paragraph",
      "content": "Add the Judge.me reviews app block here in the customizer. The widget below will be styled to match the page design."
    },
    {
      "type": "header",
      "content": "Optional CTA link"
    },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "Read all reviews →" },
    { "type": "url", "id": "cta_link", "label": "Link URL" },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding-inline-start", "label": "t:settings.left", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-inline-end", "label": "t:settings.right", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "Retaur written reviews"
    }
  ]
}
{% endschema %}
