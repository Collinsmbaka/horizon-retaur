{% comment %}
  Sales Page Payment Section
  Exact replica of React design with payment cards
{% endcomment %}

{{ 'sales-page.css' | asset_url | stylesheet_tag }}

<section class="sales-payment" id="payment-options">
  <div class="sales-payment__container">
    {%- comment -%} Header {%- endcomment -%}
    <div class="sales-payment__header">
      <div class="sales-payment__accent-bar"></div>
      <h2 class="sales-payment__title">{{ section.settings.title }}</h2>
      <p class="sales-payment__subtitle">{{ section.settings.subtitle }}</p>
    </div>

    {%- comment -%} Payment Options {%- endcomment -%}
    <div class="sales-payment__options">
      {%- comment -%} STANDARD CARD (No Cashback) {%- endcomment -%}
      <div class="sales-payment__card">
        <div class="sales-payment__card-header sales-payment__card-header--standard">
          <div class="sales-payment__badge">
            <p>{{ section.settings.card_1_badge }}</p>
          </div>
          <h3 class="sales-payment__card-title">{{ section.settings.card_1_title }}</h3>
          <p class="sales-payment__card-desc">{{ section.settings.card_1_desc }}</p>
        </div>
        <div class="sales-payment__card-body">
          {%- comment -%} Dual Price Display {%- endcomment -%}
          <div class="sales-payment__price-wrapper">
            <div class="sales-payment__price-group">
              <div class="sales-payment__price">{{ section.settings.card_1_payg_price }}</div>
              <p class="sales-payment__price-label">Every 2 months</p>
            </div>
            <div class="sales-payment__price-divider">
              <span>or</span>
            </div>
            <div class="sales-payment__price-group">
              <div class="sales-payment__price">{{ section.settings.card_1_otp_price }}</div>
              <p class="sales-payment__price-label">One time payment</p>
            </div>
          </div>

          {%- comment -%} Features List {%- endcomment -%}
          <div class="sales-payment__features">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' -%}
                {%- assign show_on_standard = false -%}
                {%- if block.settings.card_target == 'standard' or block.settings.card_target == 'both' -%}
                  {%- assign show_on_standard = true -%}
                {%- endif -%}
                {%- if show_on_standard -%}
                  <div class="sales-payment__feature" {{ block.shopify_attributes }}>
                    <svg class="sales-payment__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                      <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                    <p>{{ block.settings.text }}</p>
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- comment -%} Dual Buttons {%- endcomment -%}
          <div class="sales-payment__cta-group">
            {%- if section.settings.card_1_payg_product != blank -%}
              <button
                type="button"
                class="sales-payment__cta sales-payment__cta--secondary"
                data-add-to-cart
                data-variant-id="{{ section.settings.card_1_payg_product.selected_or_first_available_variant.id }}"
                data-payment-type="payg"
              >
                <svg class="sales-payment__cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                  <line x1="1" y1="10" x2="23" y2="10"/>
                </svg>
                <span>{{ section.settings.card_1_payg_cta }}</span>
                <svg class="sales-payment__cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </button>
            {%- endif -%}

            {%- if section.settings.card_1_otp_product != blank -%}
              <button
                type="button"
                class="sales-payment__cta sales-payment__cta--primary"
                data-add-to-cart
                data-variant-id="{{ section.settings.card_1_otp_product.selected_or_first_available_variant.id }}"
                data-payment-type="otp"
              >
                <svg class="sales-payment__cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                  <line x1="1" y1="10" x2="23" y2="10"/>
                </svg>
                <span>{{ section.settings.card_1_otp_cta }}</span>
                <svg class="sales-payment__cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </button>
            {%- endif -%}
          </div>
        </div>
      </div>

      {%- comment -%} PREMIUM CARD (₦200k Cashback) {%- endcomment -%}
      <div class="sales-payment__card sales-payment__card--featured">
        <div class="sales-payment__card-header sales-payment__card-header--premium">
          <div class="sales-payment__badge sales-payment__badge--featured">
            <p>{{ section.settings.card_2_badge }}</p>
          </div>
          <h3 class="sales-payment__card-title">{{ section.settings.card_2_title }}</h3>
          <p class="sales-payment__card-desc">{{ section.settings.card_2_desc }}</p>
          {%- if section.settings.card_2_cashback != blank -%}
            <div class="sales-payment__cashback-badge">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
              </svg>
              <span>{{ section.settings.card_2_cashback }}</span>
            </div>
          {%- endif -%}
        </div>
        <div class="sales-payment__card-body">
          {%- comment -%} Dual Price Display {%- endcomment -%}
          <div class="sales-payment__price-wrapper">
            <div class="sales-payment__price-group">
              <div class="sales-payment__price">{{ section.settings.card_2_payg_price }}</div>
              <p class="sales-payment__price-label">Every 2 months</p>
            </div>
            <div class="sales-payment__price-divider">
              <span>or</span>
            </div>
            <div class="sales-payment__price-group">
              <div class="sales-payment__price">{{ section.settings.card_2_otp_price }}</div>
              <p class="sales-payment__price-label">One time payment</p>
            </div>
          </div>

          {%- comment -%} Features List {%- endcomment -%}
          <div class="sales-payment__features">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' -%}
                {%- assign show_on_premium = false -%}
                {%- if block.settings.card_target == 'premium' or block.settings.card_target == 'both' -%}
                  {%- assign show_on_premium = true -%}
                {%- endif -%}
                {%- if show_on_premium -%}
                  <div class="sales-payment__feature" {{ block.shopify_attributes }}>
                    <svg class="sales-payment__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                      <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                    <p>{{ block.settings.text }}</p>
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- comment -%} Dual Buttons {%- endcomment -%}
          <div class="sales-payment__cta-group">
            {%- if section.settings.card_2_payg_product != blank -%}
              <button
                type="button"
                class="sales-payment__cta sales-payment__cta--secondary"
                data-add-to-cart
                data-variant-id="{{ section.settings.card_2_payg_product.selected_or_first_available_variant.id }}"
                data-payment-type="payg"
              >
                <svg class="sales-payment__cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                  <line x1="1" y1="10" x2="23" y2="10"/>
                </svg>
                <span>{{ section.settings.card_2_payg_cta }}</span>
                <svg class="sales-payment__cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </button>
            {%- endif -%}

            {%- if section.settings.card_2_otp_product != blank -%}
              <button
                type="button"
                class="sales-payment__cta sales-payment__cta--primary"
                data-add-to-cart
                data-variant-id="{{ section.settings.card_2_otp_product.selected_or_first_available_variant.id }}"
                data-payment-type="otp"
              >
                <svg class="sales-payment__cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                  <line x1="1" y1="10" x2="23" y2="10"/>
                </svg>
                <span>{{ section.settings.card_2_otp_cta }}</span>
                <svg class="sales-payment__cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </button>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} Terms {%- endcomment -%}
    <div class="sales-payment__terms">
      <p class="sales-payment__terms-text">{{ section.settings.terms_text }}</p>
      {%- if section.settings.terms_link_text != blank -%}
        <a href="{{ section.settings.terms_link }}" class="sales-payment__terms-link">
          <span>{{ section.settings.terms_link_text }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>
      {%- endif -%}
      {%- if section.settings.terms_note != blank -%}
        <p class="sales-payment__terms-note">{{ section.settings.terms_note }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function() {
    'use strict';

    // Configuration
    const CONFIG = {
      loadingClass: 'is-loading',
      loadingText: 'Adding to cart...',
      errorText: 'Error. Please try again.',
      redirectDelay: 500, // ms before redirect
    };

    /**
     * Add to cart handler for sales payment buttons
     */
    class SalesPaymentCart {
      constructor() {
        this.buttons = document.querySelectorAll('[data-add-to-cart]');
        this.init();
      }

      init() {
        this.buttons.forEach(button => {
          button.addEventListener('click', this.handleAddToCart.bind(this));
        });
      }

      /**
       * Handle add to cart click
       * @param {Event} event
       */
      async handleAddToCart(event) {
        event.preventDefault();

        const button = event.currentTarget;
        const variantId = button.dataset.variantId;
        const paymentType = button.dataset.paymentType;

        if (!variantId) {
          console.error('No variant ID specified');
          this.showError(button, 'Configuration error');
          return;
        }

        // Prevent double-clicks
        if (button.disabled || button.classList.contains(CONFIG.loadingClass)) {
          return;
        }

        try {
          await this.addProductToCart(button, variantId, paymentType);
        } catch (error) {
          this.showError(button, error.message);
        }
      }

      /**
       * Add product to cart
       * @param {HTMLButtonElement} button
       * @param {string} variantId
       * @param {string} paymentType
       */
      async addProductToCart(button, variantId, paymentType) {
        // Store original state
        const originalContent = button.innerHTML;

        // Set loading state
        this.setLoadingState(button, true);

        try {
          // Add to cart
          const cartItem = await this.addToCart(variantId, 1);

          // Track analytics if available
          this.trackAddToCart(cartItem, paymentType);

          // Success - redirect to checkout
          await this.redirectToCheckout();

        } catch (error) {
          // Restore original state on error
          this.setLoadingState(button, false);
          button.innerHTML = originalContent;
          throw error;
        }
      }

      /**
       * Add item to cart via Shopify Cart API
       * @param {number} variantId
       * @param {number} quantity
       * @returns {Promise<Object>}
       */
      async addToCart(variantId, quantity) {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            items: [{
              id: variantId,
              quantity: quantity
            }]
          })
        });

        if (!response.ok) {
          const error = await response.json();
          throw new Error(error.description || 'Failed to add to cart');
        }

        return response.json();
      }

      /**
       * Set button loading state
       * @param {HTMLButtonElement} button
       * @param {boolean} isLoading
       */
      setLoadingState(button, isLoading) {
        if (isLoading) {
          button.disabled = true;
          button.classList.add(CONFIG.loadingClass);
          button.setAttribute('aria-busy', 'true');

          // Store original content
          if (!button.dataset.originalContent) {
            button.dataset.originalContent = button.innerHTML;
          }

          // Show loading text
          const span = button.querySelector('span');
          if (span) {
            span.textContent = CONFIG.loadingText;
          }
        } else {
          button.disabled = false;
          button.classList.remove(CONFIG.loadingClass);
          button.setAttribute('aria-busy', 'false');
        }
      }

      /**
       * Show error message
       * @param {HTMLButtonElement} button
       * @param {string} message
       */
      showError(button, message) {
        console.error('Cart error:', message);

        // Show user-friendly error
        alert(`Sorry, there was an error: ${message}. Please try again.`);

        // Could also dispatch custom event for error tracking
        window.dispatchEvent(new CustomEvent('cart:error', {
          detail: { message, button }
        }));
      }

      /**
       * Track add to cart event
       * @param {Object} cartItem
       * @param {string} paymentType
       */
      trackAddToCart(cartItem, paymentType) {
        // Google Analytics 4
        if (typeof gtag === 'function') {
          gtag('event', 'add_to_cart', {
            currency: 'NGN',
            value: cartItem.price / 100,
            items: [{
              item_id: cartItem.product_id,
              item_name: cartItem.product_title,
              item_variant: cartItem.variant_title,
              payment_type: paymentType,
              price: cartItem.price / 100,
              quantity: 1
            }]
          });
        }

        // Facebook Pixel
        if (typeof fbq === 'function') {
          fbq('track', 'AddToCart', {
            content_ids: [cartItem.product_id],
            content_name: cartItem.product_title,
            content_type: 'product',
            value: cartItem.price / 100,
            currency: 'NGN'
          });
        }

        // Custom event for other tracking
        window.dispatchEvent(new CustomEvent('sales:add_to_cart', {
          detail: {
            cartItem,
            paymentType,
            timestamp: Date.now()
          }
        }));
      }

      /**
       * Redirect to checkout
       * @returns {Promise<void>}
       */
      async redirectToCheckout() {
        // Small delay for better UX
        await new Promise(resolve => setTimeout(resolve, CONFIG.redirectDelay));
        window.location.href = '/checkout';
      }
    }

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        new SalesPaymentCart();
      });
    } else {
      new SalesPaymentCart();
    }
  })();
</script>

