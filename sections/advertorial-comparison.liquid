{% comment %}
  Advertorial comparison — the dark panel carrying the price/protein table and the
  headline gap figure. This is the payoff of the argument, so it also carries
  data-adv-cta-trigger: the sticky CTA reveals itself once this scrolls past.
{% endcomment %}

<div class="adv adv-dark adv-comparison adv-section" data-adv-cta-trigger>
  <div class="adv-comparison__inner adv-container">
    <div class="adv-comparison__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="adv-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <p class="adv-note adv-comparison__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="adv-comparison__table" role="table">
        <div class="adv-comparison__row adv-comparison__row--head" role="row">
          <span role="columnheader">{{ section.settings.col_item }}</span>
          <span role="columnheader">{{ section.settings.col_protein }}</span>
          <span role="columnheader">{{ section.settings.col_price }}</span>
          <span role="columnheader">{{ section.settings.col_unit }}</span>
        </div>

        {%- for block in section.blocks -%}
          <div
            class="adv-comparison__row{% if block.settings.highlight %} adv-comparison__row--highlight{% endif %}"
            role="row"
            {{ block.shopify_attributes }}
          >
            <span role="cell" class="adv-comparison__cell-name">{{ block.settings.name }}</span>
            <span role="cell">{{ block.settings.protein }}</span>
            <span role="cell" class="adv-comparison__cell-muted">{{ block.settings.price }}</span>
            <span role="cell">{{ block.settings.per_unit }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="adv-note adv-comparison__note adv-comparison__note--mobile">{{ section.settings.note }}</p>
    {%- endif -%}

    <div class="adv-comparison__delta">
      {%- if section.settings.delta_value != blank -%}
        <span class="adv-comparison__delta-value">{{ section.settings.delta_value }}</span>
      {%- endif -%}

      <div class="adv-comparison__delta-copy">
        {%- if section.settings.delta_heading != blank -%}
          <p class="adv-comparison__delta-heading">{{ section.settings.delta_heading }}</p>
        {%- endif -%}
        {%- if section.settings.delta_body != blank -%}
          <p class="adv-comparison__delta-body">{{ section.settings.delta_body }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .adv-comparison__inner {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* On mobile the sourcing note reads better under the table than under the
     heading, so it is rendered in both slots and one is hidden per breakpoint. */
  .adv-comparison__note {
    display: none;
  }

  .adv-comparison__note--mobile {
    display: block;
  }

  .adv-comparison__table {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--adv-rule-dark);
    border-radius: 8px;
    overflow: hidden;
  }

  .adv-comparison__row {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 0.9fr 0.8fr;
    gap: 8px;
    background: var(--adv-ink);
    padding: 14px 12px;
    font-size: 14px;
    align-items: baseline;
    color: var(--retaur-cream);
  }

  .adv-comparison__row > span:not(:first-child) {
    text-align: right;
  }

  .adv-comparison__row--head {
    background: var(--retaur-black);
    padding: 10px 12px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--adv-grey-light);
  }

  .adv-comparison__row > span:nth-child(2) {
    font-weight: 700;
  }

  .adv-comparison__cell-muted {
    color: var(--adv-grey-light);
  }

  .adv-comparison__row--highlight {
    background: var(--retaur-magenta);
    padding: 16px 12px;
    color: #fff;
  }

  .adv-comparison__row--highlight .adv-comparison__cell-name {
    font-weight: 800;
  }

  .adv-comparison__row--highlight .adv-comparison__cell-muted {
    color: #fff;
    font-weight: 700;
  }

  .adv-comparison__row--highlight > span:nth-child(2),
  .adv-comparison__row--highlight > span:nth-child(4) {
    font-weight: 900;
    font-size: 16px;
  }

  .adv-comparison__delta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 1px solid var(--adv-rule-dark);
    padding-top: 20px;
  }

  .adv-comparison__delta-value {
    font-size: 56px;
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: -0.055em;
    color: var(--retaur-magenta);
  }

  .adv-comparison__delta-copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .adv-comparison__delta-heading {
    margin: 0;
    font-size: 18px;
    line-height: 1.4;
    color: var(--retaur-cream);
    font-weight: 700;
  }

  .adv-comparison__delta-body {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--adv-grey-light);
  }

  @media (min-width: 1024px) {
    .adv-comparison__inner {
      gap: 40px;
    }

    .adv-comparison__head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, auto);
      gap: 56px;
      align-items: end;
    }

    .adv-comparison__head .adv-h2 {
      max-width: 20em;
    }

    .adv-comparison__note {
      display: block;
      max-width: 26em;
    }

    .adv-comparison__note--mobile {
      display: none;
    }

    .adv-comparison__table {
      border-radius: 12px;
    }

    .adv-comparison__row {
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 24px;
      padding: 22px 28px;
      font-size: 17px;
    }

    .adv-comparison__row--head {
      padding: 16px 28px;
      font-size: 10px;
      letter-spacing: 0.14em;
    }

    .adv-comparison__row--highlight {
      padding: 26px 28px;
    }

    .adv-comparison__row--highlight > span:nth-child(2),
    .adv-comparison__row--highlight > span:nth-child(4) {
      font-size: 22px;
    }

    .adv-comparison__delta {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 40px;
      align-items: center;
      padding-top: 36px;
    }

    .adv-comparison__delta-value {
      font-size: 120px;
      line-height: 0.82;
    }

    .adv-comparison__delta-heading {
      font-size: 26px;
      line-height: 1.3;
      color: #fff;
      font-weight: 800;
      letter-spacing: -0.025em;
    }

    .adv-comparison__delta-body {
      font-size: 18px;
      max-width: 34em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Advertorial comparison",
  "tag": "section",
  "class": "adv-comparison-section",
  "max_blocks": 6,
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Here's the same shelf, priced honestly."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Sourcing note",
      "default": "Real shelf prices and real panels, photographed the week of launch. If a brand's numbers beat the assumption, it goes in anyway."
    },
    {
      "type": "header",
      "content": "Column headings"
    },
    {
      "type": "text",
      "id": "col_item",
      "label": "Column 1",
      "default": "Cup"
    },
    {
      "type": "text",
      "id": "col_protein",
      "label": "Column 2",
      "default": "Protein per cup"
    },
    {
      "type": "text",
      "id": "col_price",
      "label": "Column 3",
      "default": "Price"
    },
    {
      "type": "text",
      "id": "col_unit",
      "label": "Column 4",
      "default": "Per gram"
    },
    {
      "type": "header",
      "content": "The gap"
    },
    {
      "type": "text",
      "id": "delta_value",
      "label": "Gap figure",
      "default": "19g"
    },
    {
      "type": "text",
      "id": "delta_heading",
      "label": "Gap heading",
      "default": "Same price. Same size cup. More protein."
    },
    {
      "type": "inline_richtext",
      "id": "delta_body",
      "label": "Gap detail",
      "default": "Over a week of one cup a day, that gap is 133g of protein you either got or didn't, for identical money."
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Product",
          "default": "Greek-style brand"
        },
        {
          "type": "text",
          "id": "protein",
          "label": "Protein",
          "default": "35g"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₦5,500"
        },
        {
          "type": "text",
          "id": "per_unit",
          "label": "Per gram",
          "default": "₦157"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight this row",
          "info": "Use for your own product.",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Advertorial comparison",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "name": "Greek-style brand",
            "protein": "35g",
            "price": "₦5,500",
            "per_unit": "₦157",
            "highlight": false
          }
        },
        {
          "type": "row",
          "settings": {
            "name": "Retaur Protein Yogurt",
            "protein": "54g",
            "price": "₦5,500",
            "per_unit": "₦102",
            "highlight": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
