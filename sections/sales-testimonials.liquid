{% comment %}
  Sales Page Testimonials Section
  Exact replica of React design with before/after images
{% endcomment %}

{{ 'sales-page.css' | asset_url | stylesheet_tag }}

<section class="sales-testimonials">
  <div class="sales-testimonials__container">
    {%- comment -%} Header {%- endcomment -%}
    <div class="sales-testimonials__header">
      <div class="sales-testimonials__accent-bar"></div>
      <h2 class="sales-testimonials__title">{{ section.settings.title }}</h2>
      <p class="sales-testimonials__subtitle">{{ section.settings.subtitle }}</p>
    </div>

    {%- comment -%} Testimonials List {%- endcomment -%}
    <div class="sales-testimonials__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'testimonial' -%}
          <div class="sales-testimonial {% if forloop.index == 2 %}sales-testimonial--reverse{% endif %}" {{ block.shopify_attributes }}>
            {%- comment -%} Before/After Images {%- endcomment -%}
            <div class="sales-testimonial__images">
              <div class="sales-testimonial__image-wrapper">
                {%- if block.settings.before_image != blank -%}
                  <img
                    src="{{ block.settings.before_image | image_url: width: 600 }}"
                    alt="Before transformation"
                    class="sales-testimonial__image"
                    loading="lazy"
                  >
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'sales-testimonial__image' }}
                {%- endif -%}
                <div class="sales-testimonial__label sales-testimonial__label--before">BEFORE</div>
              </div>
              <div class="sales-testimonial__image-wrapper sales-testimonial__image-wrapper--after">
                {%- if block.settings.after_image != blank -%}
                  <img
                    src="{{ block.settings.after_image | image_url: width: 600 }}"
                    alt="After transformation"
                    class="sales-testimonial__image"
                    loading="lazy"
                  >
                {%- else -%}
                  {{ 'product-2' | placeholder_svg_tag: 'sales-testimonial__image' }}
                {%- endif -%}
                <div class="sales-testimonial__label sales-testimonial__label--after">AFTER</div>
              </div>
            </div>

            {%- comment -%} Testimonial Content {%- endcomment -%}
            <div class="sales-testimonial__content">
              <div class="sales-testimonial__stars">
                {%- for i in (1..5) -%}
                  <svg class="sales-testimonial__star" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                {%- endfor -%}
              </div>

              <div>
                <h3 class="sales-testimonial__heading">{{ block.settings.heading }}</h3>

                <div class="sales-testimonial__quote-wrapper">
                  <svg class="sales-testimonial__quote-icon" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V21c0 1 0 1 1 1z"/>
                    <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/>
                  </svg>
                  <p class="sales-testimonial__quote">{{ block.settings.quote }}</p>
                </div>
              </div>

              <div class="sales-testimonial__author">
                <p class="sales-testimonial__name">— {{ block.settings.name }}</p>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Stats Section {%- endcomment -%}
    <div class="sales-testimonials__stats">
      <div class="sales-testimonials__stats-grid">
        <div>
          <div class="sales-testimonials__stat-value">{{ section.settings.stat_1_value }}</div>
          <p class="sales-testimonials__stat-label">{{ section.settings.stat_1_label }}</p>
          <p class="sales-testimonials__stat-desc">{{ section.settings.stat_1_desc }}</p>
        </div>
        <div>
          <div class="sales-testimonials__stat-value">{{ section.settings.stat_2_value }}</div>
          <p class="sales-testimonials__stat-label">{{ section.settings.stat_2_label }}</p>
          <p class="sales-testimonials__stat-desc">{{ section.settings.stat_2_desc }}</p>
        </div>
        <div>
          <div class="sales-testimonials__stat-value">{{ section.settings.stat_3_value }}</div>
          <p class="sales-testimonials__stat-label">{{ section.settings.stat_3_label }}</p>
          <p class="sales-testimonials__stat-desc">{{ section.settings.stat_3_desc }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

