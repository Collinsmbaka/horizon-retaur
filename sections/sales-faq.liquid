{% comment %}
  Sales Page FAQ Section
  Exact replica of React design with accordion FAQ and final CTA
{% endcomment %}

{{ 'sales-page.css' | asset_url | stylesheet_tag }}

<section class="sales-faq">
  <div class="sales-faq__container">
    <div class="sales-faq__wrapper">
      {%- comment -%} Header {%- endcomment -%}
      <div class="sales-faq__header">
        <div class="sales-faq__accent-bar"></div>
        <h2 class="sales-faq__title">{{ section.settings.title }}</h2>
        <p class="sales-faq__subtitle">{{ section.settings.subtitle }}</p>
      </div>

      {%- comment -%} FAQ Items {%- endcomment -%}
      <div class="sales-faq__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <div class="sales-faq__item" {{ block.shopify_attributes }} data-faq-item>
              <div class="sales-faq__item-header" data-faq-toggle>
                <p class="sales-faq__question">{{ block.settings.question }}</p>
                <div class="sales-faq__toggle">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                  </svg>
                </div>
              </div>
              <div class="sales-faq__answer">
                <p>{{ block.settings.answer }}</p>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} Final CTA {%- endcomment -%}
      <div class="sales-faq__cta">
        <h3 class="sales-faq__cta-title">{{ section.settings.cta_title }}</h3>
        <p class="sales-faq__cta-text">{{ section.settings.cta_text }}</p>
        <a href="#payment-options" class="sales-faq__cta-button" data-scroll-to-payment>
          <span>{{ section.settings.cta_button_text }}</span>
          <svg class="sales-faq__cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // FAQ accordion functionality
    const faqItems = document.querySelectorAll('[data-faq-item]');

    faqItems.forEach(item => {
      const toggle = item.querySelector('[data-faq-toggle]');

      toggle.addEventListener('click', () => {
        // Close other items
        faqItems.forEach(otherItem => {
          if (otherItem !== item && otherItem.classList.contains('active')) {
            otherItem.classList.remove('active');
          }
        });

        // Toggle current item
        item.classList.toggle('active');
      });
    });

    // Scroll to payment functionality
    const scrollButtons = document.querySelectorAll('[data-scroll-to-payment]');
    scrollButtons.forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        const paymentSection = document.getElementById('payment-options');
        if (paymentSection) {
          paymentSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  });
</script>

