  </head>

  {%- comment -%}
    Advertorial page templates (page.advertorial*.json) ship their own minimal chrome as
    sections so paid traffic has no nav to leak through. JSON templates can't select a
    layout, so the swap happens here on the template suffix.
  {%- endcomment -%}
  {%- liquid
    assign advertorial_layout = false
    if template.suffix contains 'advertorial'
      assign advertorial_layout = true
    endif
  -%}

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}{% if advertorial_layout %} adv-page{% endif %}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    {%- unless advertorial_layout -%}
      <div id="header-group">
        {% sections 'header-group' %}
      </div>
    {%- endunless -%}

    <script
      src="{{ 'critical.js' | asset_url }}"
      type="module"
      async
      blocking="render"
    ></script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {%- unless advertorial_layout -%}
      {% sections 'footer-group' %}
    {%- endunless -%}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  </body>
</html>
