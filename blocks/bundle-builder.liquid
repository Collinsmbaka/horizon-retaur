{% liquid
  assign block_settings = block.settings
  assign product = closest.product

  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign granola_product = all_products[block_settings.granola_product_handle]
%}

{% render 'bundle-builder',
  product: product,
  granola_product: granola_product,
  settings: block_settings,
  shopify_attributes: block.shopify_attributes,
  section_id: section.id
%}

{% schema %}
{
  "name": "Bundle Builder",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Configure bundle options and granola upsell. The bundle builder works with the variant picker to allow customers to select bundle quantities (1x-6x) and optionally add granola."
    },
    {
      "type": "text",
      "id": "granola_product_handle",
      "label": "Granola Product Handle",
      "info": "Enter the handle of the granola product",
      "default": "retaur-granola"
    },
    {
      "type": "range",
      "id": "max_granola_quantity",
      "label": "Maximum Granola Quantity",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "bundle_label",
      "label": "Bundle Selection Label",
      "default": "Choose Bundle Size"
    },
    {
      "type": "text",
      "id": "granola_label",
      "label": "Add Granola Option Label",
      "default": "Add Granola"
    },
    {
      "type": "text",
      "id": "granola_each_label",
      "label": "Granola Each Label",
      "default": "each"
    },
    {
      "type": "text",
      "id": "granola_quantity_label",
      "label": "Granola Quantity Label",
      "default": "Quantity"
    },
    {
      "type": "text",
      "id": "bundle_price_label",
      "label": "Bundle Price Label",
      "default": "Bundle"
    },
    {
      "type": "text",
      "id": "granola_price_label",
      "label": "Granola Price Label",
      "default": "Granola"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total Label",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to Cart Button Label",
      "default": "Add Bundle to Cart"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Bundle Builder",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
