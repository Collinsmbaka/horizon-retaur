{%- liquid
  assign block_settings = block.settings
  assign filled = block_settings.stars_filled | default: 5
  assign star_total = 5
-%}

<div
  class="retaur-stars-row spacing-style"
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  <span
    class="retaur-stars"
    aria-label="{{ block_settings.rating | escape }} out of {{ star_total }} stars"
    role="img"
  >
    {%- for i in (1..star_total) -%}
      {%- if i <= filled -%}
        <svg class="retaur-star retaur-star--filled" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2l3 7 7 .8-5.2 4.7L18 22l-6-3.5L6 22l1.2-7.5L2 9.8l7-.8 3-7z"/>
        </svg>
      {%- else -%}
        <svg class="retaur-star retaur-star--empty" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2l3 7 7 .8-5.2 4.7L18 22l-6-3.5L6 22l1.2-7.5L2 9.8l7-.8 3-7z"/>
        </svg>
      {%- endif -%}
    {%- endfor -%}
  </span>
  <span class="retaur-stars-text">
    {%- if block_settings.rating != blank -%}
      <strong>{{ block_settings.rating | escape }}</strong>
      {%- if block_settings.review_count_label != blank -%} · {%- endif -%}
    {%- endif -%}
    {%- if block_settings.review_count_label != blank -%}
      {%- if block_settings.review_link != blank -%}
        <a href="{{ block_settings.review_link | escape }}">{{ block_settings.review_count_label | escape }}</a>
      {%- else -%}
        {{ block_settings.review_count_label | escape }}
      {%- endif -%}
    {%- endif -%}
  </span>
</div>

{% schema %}
{
  "name": "Retaur stars row",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "rating",
      "label": "Rating value",
      "default": "4.9"
    },
    {
      "type": "range",
      "id": "stars_filled",
      "label": "Filled stars",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "review_count_label",
      "label": "Review count label",
      "default": "Based on 13 reviews"
    },
    {
      "type": "url",
      "id": "review_link",
      "label": "Link to reviews section"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Retaur stars row",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
