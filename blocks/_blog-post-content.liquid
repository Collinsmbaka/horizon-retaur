<div class="blog-post-content rte">
  <rte-formatter>
    {{ article.content }}
  </rte-formatter>
</div>

{% stylesheet %}
  .blog-post-content {
    max-width: var(--wide-content-width);
    margin: 0 auto;
    font-size: var(--font-size--md);
    line-height: 1.75;
    color: var(--color-foreground);
  }

  /* ===================================
     1. TYPOGRAPHY - HEADINGS
     =================================== */
  .blog-post-content h1,
  .blog-post-content h2,
  .blog-post-content h3,
  .blog-post-content h4,
  .blog-post-content h5,
  .blog-post-content h6 {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    color: var(--color-foreground-heading);
    line-height: 1.3;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    scroll-margin-top: 100px;
  }

  .blog-post-content h1 {
    font-size: clamp(2rem, 5vw, 2.5rem);
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  .blog-post-content h2 {
    font-size: clamp(1.75rem, 4vw, 2rem);
    margin-top: 3rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid rgb(var(--color-foreground-rgb) / 0.1);
  }

  .blog-post-content h3 {
    font-size: clamp(1.375rem, 3vw, 1.5rem);
    margin-top: 2rem;
  }

  .blog-post-content h4 {
    font-size: clamp(1.125rem, 2.5vw, 1.25rem);
    margin-top: 1.75rem;
  }

  .blog-post-content h5 {
    font-size: 1.125rem;
    margin-top: 1.5rem;
  }

  .blog-post-content h6 {
    font-size: 1rem;
    margin-top: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* ===================================
     2. PARAGRAPHS & TEXT
     =================================== */
  .blog-post-content p {
    margin-bottom: 1.25rem;
    line-height: 1.75;
  }

  .blog-post-content p:last-child {
    margin-bottom: 0;
  }

  /* First paragraph after h2 - slightly larger */
  .blog-post-content h2 + p {
    font-size: 1.0625rem;
    margin-top: 1.25rem;
  }

  .blog-post-content strong {
    font-weight: 700;
    color: var(--color-foreground-heading);
  }

  .blog-post-content em {
    font-style: italic;
  }

  /* ===================================
     3. LINKS
     =================================== */
  .blog-post-content a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .blog-post-content a:hover {
    color: var(--color-primary-hover);
    text-decoration-color: transparent;
  }

  /* ===================================
     4. LISTS
     =================================== */
  .blog-post-content ul,
  .blog-post-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.75rem;
  }

  .blog-post-content ul {
    list-style-type: disc;
  }

  .blog-post-content ol {
    list-style-type: decimal;
  }

  .blog-post-content li {
    margin-bottom: 0.75rem;
    line-height: 1.7;
    padding-left: 0.5rem;
  }

  .blog-post-content li:last-child {
    margin-bottom: 0;
  }

  /* Nested lists */
  .blog-post-content li > ul,
  .blog-post-content li > ol {
    margin-top: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .blog-post-content ul ul {
    list-style-type: circle;
  }

  .blog-post-content ul ul ul {
    list-style-type: square;
  }

  /* Enhanced list items with strong tags */
  .blog-post-content li strong:first-child {
    color: var(--color-foreground-heading);
  }

  /* ===================================
     5. SECTIONS
     =================================== */
  .blog-post-content section {
    margin-bottom: 3rem;
  }

  .blog-post-content section:last-child {
    margin-bottom: 0;
  }

  /* Introduction/Quick Answer sections */
  .blog-post-content section#introduction,
  .blog-post-content section[id*="quick"] {
    background: rgb(var(--color-foreground-rgb) / 0.03);
    border-left: 4px solid var(--color-primary);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 2.5rem;
  }

  .blog-post-content section#introduction h2,
  .blog-post-content section[id*="quick"] h2 {
    margin-top: 0;
    border-bottom: none;
    padding-bottom: 0;
  }

  .blog-post-content section#introduction p:first-of-type {
    font-size: 1.0625rem;
  }

  /* Related articles section */
  .blog-post-content section#related-articles {
    background: rgb(var(--color-foreground-rgb) / 0.02);
    padding: 2rem;
    border-radius: 8px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
  }

  /* ===================================
     6. TABLES
     =================================== */
  .blog-post-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.9375rem;
    background: var(--color-background);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgb(var(--color-foreground-rgb) / 0.08);
  }

  .blog-post-content thead {
    background: rgb(var(--color-foreground-rgb) / 0.05);
  }

  .blog-post-content th {
    font-weight: 700;
    text-align: left;
    padding: 1rem;
    border-bottom: 2px solid rgb(var(--color-foreground-rgb) / 0.15);
    text-transform: uppercase;
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
    color: var(--color-foreground-heading);
  }

  .blog-post-content td {
    padding: 0.875rem 1rem;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }

  .blog-post-content tbody tr:last-child td {
    border-bottom: none;
  }

  /* Zebra striping */
  .blog-post-content tbody tr:nth-child(even) {
    background: rgb(var(--color-foreground-rgb) / 0.02);
  }

  .blog-post-content tbody tr:hover {
    background: rgb(var(--color-foreground-rgb) / 0.04);
    transition: background 0.2s ease;
  }

  /* Table wrapper for horizontal scroll */
  .blog-post-content .rte-table-wrapper,
  .blog-post-content > table {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 2rem 0;
  }

  /* Mobile table adjustments */
  @media screen and (max-width: 749px) {
    .blog-post-content table {
      font-size: 0.875rem;
      display: block;
      overflow-x: auto;
    }

    .blog-post-content th,
    .blog-post-content td {
      padding: 0.75rem;
      white-space: nowrap;
    }

    .blog-post-content th {
      font-size: 0.75rem;
    }
  }

  /* ===================================
     7. BLOCKQUOTES
     =================================== */
  .blog-post-content blockquote {
    margin: 2rem 0;
    padding: 1.5rem 1.5rem 1.5rem 2rem;
    border-left: 4px solid rgb(var(--color-foreground-rgb) / 0.3);
    background: rgb(var(--color-foreground-rgb) / 0.02);
    font-style: italic;
    font-size: 1.0625rem;
    border-radius: 4px;
  }

  .blog-post-content blockquote p {
    margin-bottom: 0.75rem;
  }

  .blog-post-content blockquote p:last-child {
    margin-bottom: 0;
  }

  /* ===================================
     8. CODE BLOCKS (if needed)
     =================================== */
  .blog-post-content code {
    background: rgb(var(--color-foreground-rgb) / 0.06);
    padding: 0.2em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: 'Monaco', 'Courier New', monospace;
  }

  .blog-post-content pre {
    background: rgb(var(--color-foreground-rgb) / 0.04);
    padding: 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
  }

  .blog-post-content pre code {
    background: none;
    padding: 0;
    font-size: 0.875rem;
  }

  /* ===================================
     9. HORIZONTAL RULES
     =================================== */
  .blog-post-content hr {
    border: none;
    border-top: 2px solid rgb(var(--color-foreground-rgb) / 0.1);
    margin: 2.5rem 0;
  }

  /* ===================================
     10. IMAGES & FIGURES
     =================================== */
  .blog-post-content img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 2rem 0;
  }

  .blog-post-content figure {
    margin: 2rem 0;
  }

  .blog-post-content figcaption {
    font-size: 0.875rem;
    color: rgb(var(--color-foreground-rgb) / 0.7);
    text-align: center;
    margin-top: 0.75rem;
    font-style: italic;
  }

  /* ===================================
     11. ARTICLE METADATA & CALLOUTS
     =================================== */
  .blog-post-content .article-meta {
    background: rgb(var(--color-primary-rgb) / 0.05);
    border-radius: 8px;
    padding: 1.25rem;
    margin: 1.5rem 0;
    border-left: 3px solid var(--color-primary);
  }

  /* Note/Tip boxes (if added via HTML) */
  .blog-post-content .note,
  .blog-post-content .tip {
    background: rgb(var(--color-foreground-rgb) / 0.03);
    padding: 1.25rem;
    border-radius: 8px;
    margin: 1.5rem 0;
    border-left: 3px solid rgb(var(--color-foreground-rgb) / 0.3);
  }

  /* ===================================
     12. RESPONSIVE DESIGN - MOBILE
     =================================== */
  @media screen and (max-width: 749px) {
    .blog-post-content {
      font-size: 1rem;
      line-height: 1.7;
    }

    .blog-post-content h1 {
      font-size: 1.75rem;
      margin-bottom: 1.25rem;
    }

    .blog-post-content h2 {
      font-size: 1.5rem;
      margin-top: 2rem;
    }

    .blog-post-content h3 {
      font-size: 1.25rem;
      margin-top: 1.75rem;
    }

    .blog-post-content h4 {
      font-size: 1.125rem;
    }

    .blog-post-content section {
      margin-bottom: 2rem;
    }

    .blog-post-content section#introduction,
    .blog-post-content section[id*="quick"] {
      padding: 1.25rem;
      margin-bottom: 2rem;
    }

    .blog-post-content ul,
    .blog-post-content ol {
      padding-left: 1.5rem;
    }

    .blog-post-content li {
      padding-left: 0.25rem;
    }

    .blog-post-content blockquote {
      margin: 1.5rem 0;
      padding: 1rem 1rem 1rem 1.25rem;
      font-size: 1rem;
    }
  }

  /* ===================================
     13. PRINT STYLES
     =================================== */
  @media print {
    .blog-post-content {
      font-size: 12pt;
      line-height: 1.6;
      color: #000;
    }

    .blog-post-content a {
      color: #000;
      text-decoration: underline;
    }

    .blog-post-content section#introduction {
      border-left-color: #000;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.content",
  "settings": [],
  "presets": [
    {
      "name": "t:names.content"
    }
  ]
}
{% endschema %}
