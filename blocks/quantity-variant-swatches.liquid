{% liquid
  assign product_resource = closest.product
  assign block_settings = block.settings

  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif

  # Find the "Quantity" option
  assign quantity_option = null
  assign quantity_option_position = 0

  for option in product_resource.options_with_values
    assign option_name_lower = option.name | downcase
    if option_name_lower contains 'quantity'
      assign quantity_option = option
      assign quantity_option_position = forloop.index
      break
    endif
  endfor
%}

{% if quantity_option %}
  <div
    class="quantity-variant-swatches spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    <quantity-variant-swatches-component data-option-position="{{ quantity_option_position }}">
      <fieldset class="variant-option variant-option--quantity-swatches">
        <legend>{{ block_settings.quantity_label | default: 'Choose Bundle Size' }}</legend>

        <div class="quantity-swatches-grid">
          {%- for value in quantity_option.values -%}
            {% liquid
              # Find the variant for this specific quantity value
              assign variant_for_quantity = null
              for variant in product_resource.variants
                if variant.option1 == value or variant.option2 == value or variant.option3 == value
                  assign variant_for_quantity = variant
                  break
                endif
              endfor
            %}

            <label class="quantity-swatch{% if value.selected %} quantity-swatch--selected{% endif %}{% unless variant_for_quantity.available %} quantity-swatch--unavailable{% endunless %}">
              <input
                type="radio"
                name="quantity-option-{{ section.id }}"
                value="{{ value | escape }}"
                data-option-position="{{ quantity_option_position }}"
                data-variant-id="{{ variant_for_quantity.id }}"
                {% if value.selected %}checked{% endif %}
                {% unless variant_for_quantity.available %}disabled{% endunless %}
              >

              <div class="quantity-swatch__content">
                {%- if variant_for_quantity.featured_image -%}
                  <img
                    src="{{ variant_for_quantity.featured_image | image_url: width: 120 }}"
                    alt="{{ value }}x bundle"
                    class="quantity-swatch__image"
                    loading="lazy"
                  >
                {%- elsif product_resource.featured_image -%}
                  <img
                    src="{{ product_resource.featured_image | image_url: width: 120 }}"
                    alt="{{ value }}x bundle"
                    class="quantity-swatch__image"
                    loading="lazy"
                  >
                {%- endif -%}

                <div class="quantity-swatch__quantity">{{ value }}x</div>

                {%- if variant_for_quantity -%}
                  <div class="quantity-swatch__price">{{ variant_for_quantity.price | money }}</div>

                  {%- if variant_for_quantity.compare_at_price > variant_for_quantity.price -%}
                    {% assign savings = variant_for_quantity.compare_at_price | minus: variant_for_quantity.price %}
                    <div class="quantity-swatch__savings">Save {{ savings | money }}</div>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </label>
          {%- endfor -%}
        </div>
      </fieldset>

      <script type="application/json" data-variant-data>
        {
          "variants": [
            {%- for variant in product_resource.variants -%}
              {
                "id": {{ variant.id | json }},
                "title": {{ variant.title | json }},
                "option1": {{ variant.option1 | json }},
                "option2": {{ variant.option2 | json }},
                "option3": {{ variant.option3 | json }},
                "price": {{ variant.price | json }},
                "available": {{ variant.available | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
      </script>
    </quantity-variant-swatches-component>
  </div>
{% endif %}

{% stylesheet %}
  /* Hide the Quantity option from the standard variant picker */
  .variant-picker fieldset.variant-option legend:has(+ .variant-option__button-label input[name*="Quantity"]),
  .variant-picker fieldset.variant-option:has(legend:contains("Quantity")) {
    display: none !important;
  }

  /* Alternative: use JavaScript-free CSS to hide quantity fieldset */
  variant-picker fieldset:nth-of-type(2) {
    display: none;
  }

  .quantity-variant-swatches {
    width: 100%;
  }

  .variant-option--quantity-swatches {
    border: none;
    padding: 0;
    margin: 0;
  }

  .variant-option--quantity-swatches legend {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 16px;
    padding: 0;
  }

  .quantity-swatches-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 12px;
  }

  .quantity-swatch {
    display: flex;
    flex-direction: column;
    position: relative;
    cursor: pointer;
    border: 2px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-background);
    transition: all 0.2s ease;
    overflow: hidden;
  }

  .quantity-swatch:hover {
    border-color: var(--color-primary);
    background: var(--color-background-secondary);
  }

  .quantity-swatch--selected {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 2px var(--color-primary);
  }

  .quantity-swatch--unavailable {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .quantity-swatch input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
    margin: 0;
  }

  .quantity-swatch__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 12px;
    gap: 8px;
  }

  .quantity-swatch__image {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 6px;
  }

  .quantity-swatch__quantity {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .quantity-swatch__price {
    font-size: 0.875rem;
    color: var(--color-foreground-secondary);
  }

  .quantity-swatch__savings {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-success, #10b981);
    background: rgb(from var(--color-success, #10b981) r g b / 0.1);
    padding: 2px 8px;
    border-radius: 4px;
  }

  @media (max-width: 749px) {
    .quantity-swatches-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .quantity-swatch__image {
      width: 60px;
      height: 60px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Quantity Variant Swatches",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "quantity_label",
      "label": "Quantity Label",
      "default": "Choose Bundle Size"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Quantity Variant Swatches",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
