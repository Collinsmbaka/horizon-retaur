                "heading": "Is Creatine safe to use?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_fnmy9Q": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes, creatine is one of the most researched supplements and has been proven to be safe for most people when used as directed. Always stick to the recommended dosages and consult with a healthcare professional if you have any underlying health conditions like kidney infection.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
