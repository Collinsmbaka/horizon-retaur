          "blocks": {
            "accordion_row_xUGVnG": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What is creatine, and how does it work?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_AimWBr": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Creatine is a natural substance found in muscles that helps provide energy during high-intensity activities. It works by increasing the production of ATP (adenosine triphosphate), which is the primary energy source for muscle contractions.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
