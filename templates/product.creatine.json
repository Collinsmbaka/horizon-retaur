              "blocks": {
                "text_7EtKHD": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>While creatine is popular among bodybuilders and athletes due to its performance-enhancing effects, it can also benefit individuals engaged in various forms of exercise, including resistance training, high-intensity interval training, and endurance activities.</p>",
                    "width": "100%",
                    "max_width": "normal",
