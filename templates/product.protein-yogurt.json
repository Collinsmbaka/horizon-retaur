    "retaur_faq": {
      "type": "retaur-faq",
      "blocks": {
        "fq1": {
          "type": "faq-item",
          "settings": {
            "question": "Is Retaur protein yogurt suitable for everyday consumption?",
            "answer": "<p>Yes. Retaur protein yogurt is made for daily consumption — high-quality ingredients and a balanced macro profile that fits into most dietary plans while helping you meet your protein needs without a shaker bottle.</p>",
            "open_by_default": true
          }
        },
        "fq2": {
          "type": "faq-item",
          "settings": {
            "question": "How much protein is in each cup?",
            "answer": "<p>54g per 400g cup. That's about the protein content of ten eggs, packed into one yogurt — enough for muscle recovery, satiety, and most people's daily target in a single serving.</p>",
            "open_by_default": false
          }
        },
        "fq3": {
          "type": "faq-item",
          "settings": {
            "question": "How does Retaur compare to regular Greek yogurt?",
            "answer": "<p>Significantly higher protein (54g per cup vs 25–30g for Greek). Formulated with added whey protein for muscle support while keeping the creamy texture. Less sugar than most commercial Greek yogurts, more targeted for active lifestyles.</p>",
            "open_by_default": false
          }
        },
        "fq4": {
          "type": "faq-item",
          "settings": {
            "question": "What are the ingredients?",
            "answer": "<p>Low-fat milk, whey protein concentrate, and a touch of sugar for sweetness. No artificial preservatives, no artificial colors, no excessive added sugars. Clean and simple.</p>",
            "open_by_default": false
          }
        },
        "fq5": {
          "type": "faq-item",
          "settings": {
            "question": "Can I enjoy Retaur if I'm trying to lose weight?",
            "answer": "<p>Absolutely. High protein content promotes satiety so you stay full longer, while the balanced nutritional profile gives you essential nutrients without excessive calories.</p>",
            "open_by_default": false
          }
        },
        "fq6": {
          "type": "faq-item",
          "settings": {
            "question": "When is the best time to have Retaur?",
            "answer": "<p>Anytime. Post-workout within the 2-hour recovery window, breakfast on a busy morning, a mid-day snack to prevent hunger, or a nutritious dessert in the evening.</p>",
            "open_by_default": false
          }
        },
        "fq7": {
          "type": "faq-item",
          "settings": {
            "question": "How can I incorporate Retaur into meal prep?",
            "answer": "<p>Use it as a base for overnight oats. Build parfait jars with granola and berries. Blend into smoothie packs. Swap it in for sour cream in dips. Mix into protein pancake batter. Very versatile.</p>",
            "open_by_default": false
          }
        }
      },
